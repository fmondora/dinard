</Placemark>
<Placemark>
  <name>Saint-Malo Intra-Muros</name>
  <description><![CDATA[<p>[🏛️ Centro] Città fortificata. 10 min in ferry da Dinard.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6487018%2C-2.0199432">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s5</styleUrl>
  <Point><coordinates>-2.0199432,48.6487018,0</coordinates></Point>
</Placemark>
<Placemark>
  <name>Cancale (centro)</name>
  <description><![CDATA[<p>[🏛️ Centro] Capitale delle ostriche. ~30 min auto da Dinard.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6773205%2C-1.8645809">Apri in Google Maps</a></p>]]></description>
