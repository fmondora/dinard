</Folder>
<Folder><name>⛴️ Ferry</name>
<Placemark>
  <name>Ferry Dinard — Compagnie Corsaire (Clair de Lune)</name>
  <description><![CDATA[<p>[⛴️ Ferry] Promenade du Clair de Lune. → Saint-Malo (~10&#x27;), Cézembre (~20&#x27;), escursioni Chausey, Cap Fréhel, Cancale, Rance/Dinan, Jersey. compagniecorsaire.com</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6339345%2C-2.0500957">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s6</styleUrl>
  <Point><coordinates>-2.0500957,48.6339345,0</coordinates></Point>
</Placemark>
<Placemark>
  <name>Ferry Dinard — Cale du Bec de la Vallée</name>
  <description><![CDATA[<p>[⛴️ Ferry] Cale di Dinard (alta stagione). Partenze vedettes / bus de mer.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6357303%2C-2.0475675">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s6</styleUrl>
  <Point><coordinates>-2.0475675,48.6357303,0</coordinates></Point>
</Placemark>
<Placemark>
  <name>Ferry Saint-Malo — Cale de Dinan</name>
  <description><![CDATA[<p>[⛴️ Ferry] Ai piedi delle mura Intra-Muros. Arrivo/partenza bus de mer ↔ Dinard.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6456217%2C-2.0272486">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s6</styleUrl>
  <Point><coordinates>-2.0272486,48.6456217,0</coordinates></Point>
</Placemark>
</Folder>
<Folder><name>🥾 Camminate</name>
<Placemark>
  <name>Promenade du Clair de Lune</name>
  <description><![CDATA[<p>[🥾 Camminate] ~2 km dal Prieuré all&#x27;anse du Bec de la Vallée. Vegetazione esotica, vista Saint-Malo. Facile, iconica.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6303758%2C-2.0527440">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s7</styleUrl>
  <Point><coordinates>-2.0527440,48.6303758,0</coordinates></Point>
</Placemark>
<Placemark>
  <name>Pointe du Moulinet</name>
  <description><![CDATA[<p>[🥾 Camminate] Belvedere da l&#x27;Écluse. Vista 360° su baia, Saint-Malo, Cézembre. Ideale al tramonto.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6369843%2C-2.0494501">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s7</styleUrl>
  <Point><coordinates>-2.0494501,48.6369843,0</coordinates></Point>
</Placemark>
<Placemark>
  <name>GR34 partenza Écluse → Saint-Lunaire</name>
  <description><![CDATA[<p>[🥾 Camminate] ~8 km, 1h30–2h. Costiero: Écluse → Énogat → Port-Blanc → Saint-Lunaire.</p><p><a href="https://www.google.com/maps/search/?api=1&amp;query=48.6364681%2C-2.0553620">Apri in Google Maps</a></p>]]></description>
  <styleUrl>#s7</styleUrl>
  <Point><coordinates>-2.0553620,48.6364681,0</coordinates></Point>
</Placemark>
